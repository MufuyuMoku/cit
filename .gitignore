# Build output
/build/bin/
/frontend/build/*
!/frontend/build/.gitkeep
/frontend/.svelte-kit/
/frontend/node_modules/

# Wails-generated JS/TS bindings — regenerated on every `wails build` / `wails dev`
/frontend/src/lib/wailsjs/

# Wails' cache marker for "do I need to re-run npm install?"
/frontend/package.json.md5

# Spesifikasi versi PDF disimpan di luar repo. docs/spesifikasi.md adalah
# sumber kebenaran; PDF hanyalah cetakan darinya dan tidak perlu diversikan.
*.pdf

# Local scratch
*.local
.DS_Store
Thumbs.db
